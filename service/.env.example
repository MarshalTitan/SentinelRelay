NODE_ENV=production
PORT=8080
DATABASE_PATH=/data/sentinel-relay.db
PUBLIC_BASE_URL=https://your-sentinel-relay-host.example

# Create these in the Discord Developer Portal. Never commit real values.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Recommended during initial setup for instant command registration.
# Remove later to register commands globally (global registration can take longer).
DISCORD_GUILD_ID=

# Optional comma-separated installation IDs allowed to pair.
# Leave blank for normal configurable operation.
ALLOWED_INSTALLATION_IDS=

